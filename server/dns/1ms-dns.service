# /etc/systemd/system/1ms-dns.service: the zone's authoritative DNS + results API (source: this directory).
# This is a template: replace <zone>, <zone-ns>, <bind-v4>, <public-v4> and <public-v6> before installing. The bind
# address is the machine's own; where the provider delivers the public address over NAT, it is the private one.
# Ports, directory, user and service name: 53/udp+tcp and 2053/tcp, /opt/1ms/dns/, user 1ms-dns, 1ms-dns.
# 127.0.0.1:2054 is a plain-HTTP copy of the API on loopback, for checks on the machine itself.
# Query records stay in memory for 2 minutes; no access log; its own output is startup and errors only.
[Unit]
Description=Authoritative DNS and results API (dns-test)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/1ms/dns/1ms-dns -dns <bind-v4>:53,[<public-v6>]:53 -api <bind-v4>:2053,[<public-v6>]:2053 -zone <zone> -ns <zone-ns> -a <public-v4> -aaaa <public-v6> -api-http 127.0.0.1:2054 -state /var/lib/1ms-dns
User=1ms-dns
Group=1ms-dns
Restart=always
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
StateDirectory=1ms-dns
StateDirectoryMode=0700
Environment=GOMEMLIMIT=64MiB
MemoryMax=128M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
